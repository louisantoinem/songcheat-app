# Front-end config read by Create React App at build time (REACT_APP_* only).
# These values are NOT secret for a SPA: they are embedded in the JS bundle.

# Auth0 (same tenant as hexxit)
REACT_APP_AUTH0_DOMAIN=hexxit.eu.auth0.com
# Client ID of the Auth0 *Single Page Application* you created for songcheat:
REACT_APP_AUTH0_CLIENT_ID=czA8jqFaQGIJ1P1njIXzBilbZR1xhGFZ
# Identifier of the Auth0 API (must match AUTH0_AUDIENCE in songcheat-api/.env)
REACT_APP_AUTH0_AUDIENCE=https://songcheat/api/v1

# Base URL of the songcheat-api
REACT_APP_API_URL=http://localhost:8282/api/v1
