# Front-end config read by Vite at build time (VITE_* only).
# These values are NOT secret for a SPA: they are embedded in the JS bundle.
# Shared across all modes; per-mode overrides live in .env.development / .env.production.

# Auth0 (same tenant as hexxit)
VITE_AUTH0_DOMAIN=hexxit.eu.auth0.com
# Client ID of the Auth0 *Single Page Application* you created for songcheat:
VITE_AUTH0_CLIENT_ID=czA8jqFaQGIJ1P1njIXzBilbZR1xhGFZ
# Identifier of the Auth0 API (must match AUTH0_AUDIENCE in songcheat-api/.env)
VITE_AUTH0_AUDIENCE=https://songcheat/api/v1
